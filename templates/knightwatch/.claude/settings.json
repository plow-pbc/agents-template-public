{
  "enabledPlugins": {"superpowers@claude-plugins-official": false},
  "permissions": {
    "deny": ["Bash", "WebFetch", "WebSearch", "Edit", "NotebookEdit"]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/kw-allow\" || exit 2", "timeout": 30}]}
    ]
  }
}
